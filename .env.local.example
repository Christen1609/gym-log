# Copy to .env.local and fill in. Nothing here is required to run the app —
# it works with local fallback data and localStorage persistence out of the
# box. Each var upgrades one part of the spec once you have it:

# AI coach judgment (src/lib/coach.ts). Without this, the coach uses the
# fixed copy from the design prototype — the app is fully functional either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase — Postgres + Google auth (src/lib/supabase.ts, supabase/migrations).
# Without this, sets logged this session live in localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Spotify — now-playing + playback control (src/lib/spotify.ts). Uses the
# PKCE flow, so only the client ID is needed — no secret. Create an app at
# https://developer.spotify.com/dashboard and register the redirect URI
# http://127.0.0.1:3000/ (Spotify rejects "localhost" — use the loopback IP,
# and open the app at http://127.0.0.1:3000 when connecting). Without this,
# the Spotify screen runs on local mock state.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
